{
  "name": "ruyi",
  "version": "1.5.3",
  "description": "Cross-conversation memory for AI agents — learns how you think and what you prefer. Zero deps, one SQLite file.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/cli.ts serve",
    "mcp": "node src/cli.ts mcp",
    "distill": "node src/cli.ts distill",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaqii/ruyi.git"
  },
  "bin": {
    "ruyi": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "docs",
    "examples",
    "scripts",
    "systemd",
    "config.example.json",
    "AGENT.README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "docker-compose.yml",
    "Dockerfile"
  ],
  "keywords": [
    "llm",
    "ai-agents",
    "memory",
    "long-term-memory",
    "agent-memory",
    "mcp",
    "claude-code",
    "sqlite",
    "personalization"
  ]
}
