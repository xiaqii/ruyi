# Installed variant of ruyi.service.template (install.sh substitutes __ROOT__/__NODE__).
[Unit]
Description=ruyi (如忆) long-term memory service for AI agents
After=network.target

[Service]
Type=simple
WorkingDirectory=/app/ruyi
ExecStart=/usr/bin/node /app/ruyi/src/cli.ts serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
