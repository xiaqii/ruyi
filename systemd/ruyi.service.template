# Template — install.sh substitutes __ROOT__/__NODE__ and installs into systemd.
[Unit]
Description=ruyi (如忆) long-term memory service for AI agents
After=network.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
ExecStart=__NODE__ __ROOT__/src/cli.ts serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
