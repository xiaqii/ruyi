// opencode MCP registration — merge into ~/.config/opencode/opencode.jsonc with the repo's absolute path.
{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ruyi": {
      "type": "local",
      "command": ["node", "/ABSOLUTE/PATH/TO/ruyi/src/cli.ts", "mcp"],
      "enabled": true
    }
  }
}
